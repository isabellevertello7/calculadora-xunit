public class Calculadora {

    public int somar(int numeroUm, int numeroDois) {
        return numeroUm + numeroDois;
    }

    public int subtrair(int numeroUm, int numeroDois) {
        return numeroUm - numeroDois;
    }

    public int multiplicar(int numeroUm, int numeroDois) {
        return numeroUm * numeroDois;
    }

    public double dividir(int numeroUm, int numeroDois) {
        if (numeroDois == 0) {
            throw new IllegalArgumentException("Não é possível dividir por zero.");
        }
        return (double) numeroUm / numeroDois;
    }

    public double potenciar(int numeroUm, int numeroDois) {
        return Math.pow(numeroUm, numeroDois);
    }

    public static void main(String[] args) {
        Calculadora calculadora = new Calculadora();
        
        System.out.println("Somar: " + (calculadora.somar(2, 3) == 5 ? "Passou" : "Falhou"));
        System.out.println("Subtrair: " + (calculadora.subtrair(5, 3) == 2 ? "Passou" : "Falhou"));
        System.out.println("Multiplicar: " + (calculadora.multiplicar(2, 3) == 6 ? "Passou" : "Falhou"));
        
        try {
            System.out.println("Dividir: " + (calculadora.dividir(6, 3) == 2.0 ? "Passou" : "Falhou"));
        } catch (IllegalArgumentException e) {
            System.out.println("Erro na divisão: " + e.getMessage());
        }
        
        System.out.println("Potenciar: " + (calculadora.potenciar(2, 3) == 8.0 ? "Passou" : "Falhou"));
    }
}
